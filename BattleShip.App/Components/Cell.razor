@using BattleShip.Models

<button class="cell @(GetCellClass())"
        @onclick="HandleClick"
        @oncontextmenu="HandleRightClick"
        @oncontextmenu:preventDefault
        @onmouseenter="HandleMouseEnter"
        @onmouseleave="HandleMouseLeave">
</button>

@code {

    [Parameter, EditorRequired]
    public Position Position { get; set; }

    [Parameter]
    public bool HasShip { get; set; }

    [Parameter]
    public bool IsPreview { get; set; }

    [Parameter]
    public bool HideShip { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public EventCallback OnRightClick { get; set; }

    [Parameter]
    public EventCallback OnMouseEnter { get; set; }

    [Parameter]
    public EventCallback OnMouseLeave { get; set; }

    [Parameter]
    public bool IsPreviewValid { get; set; }


    private string GetCellClass()
    {
        if (IsPreview)
        {
            return IsPreviewValid
                ? "preview"
                : "preview-invalid";
        }

        if (HasShip && !HideShip)
            return "ship";

        return string.Empty;
    }


    private Task HandleClick()
    {
        return OnClick.InvokeAsync();
    }


    private Task HandleRightClick()
    {
        return OnRightClick.InvokeAsync();
    }


    private Task HandleMouseEnter()
    {
        return OnMouseEnter.InvokeAsync();
    }


    private Task HandleMouseLeave()
    {
        return OnMouseLeave.InvokeAsync();
    }
}