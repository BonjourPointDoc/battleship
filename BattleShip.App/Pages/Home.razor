@page "/"
@using System.Globalization
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>BattleShip</PageTitle>

<div class="home">
    <div class="radar" aria-hidden="true">
        <div class="radar-grid">
            <span class="radar-ring ring-1"></span>
            <span class="radar-ring ring-2"></span>
            <span class="radar-ring ring-3"></span>
            <span class="radar-ring ring-4"></span>

            <span class="radar-axis axis-x"></span>
            <span class="radar-axis axis-y"></span>

            <span class="radar-sweep"></span>

            @foreach (var target in Targets)
            {
                <span class="radar-target"
                      style="@($"--x:{target.X.ToString(CultureInfo.InvariantCulture)}%;--y:{target.Y.ToString(CultureInfo.InvariantCulture)}%;--delay:{target.Delay.ToString(CultureInfo.InvariantCulture)}s")"></span>
            }

            <span class="radar-center"></span>
        </div>
    </div>

    <div class="home-content">

        <h1>BattleShip</h1>

        <button class="start-button"
                @onclick="StartGame"
                disabled="@IsLoading">
            @(IsLoading ? "Chargement..." : "Nouvelle partie")
        </button>

        <div class="games-section">

            <h2>Mes parties</h2>

            @if (IsLoadingGames)
            {
                <p class="no-games">Chargement des parties en cours...</p>
            }
            else if (Games.Count == 0)
            {
                <p class="no-games">
                    Aucune partie jouée.
                </p>
            }
            else
            {
                <div class="games-list">

                    @foreach (var game in Games)
                    {
                        <div class="game-item">

                            <div class="game-info">

                                <span class="game-date">
                                    @game.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </span>

                                <span class="game-status">
                                    @GetStatusText(game)
                                </span>

                            </div>

                           @if (game.Status != 2) @* 2 correspond à Finished *@
                            {
                                <button class="continue-button"
                                        @onclick="() => ContinueGame(game.Id)">
                                    Continuer
                                </button>
                            }

                        </div>
                    }

                </div>
            }

        </div>

    </div>

</div>

@code {

    private const double RadarDuration = 6.0;
    private readonly Random Random = new();
    private readonly List<RadarTarget> Targets = [];

    private List<GameStateDto> Games = [];
    private bool IsLoading;
    private bool IsLoadingGames = true;

    protected override async Task OnInitializedAsync()
    {
        // Génération visuelle des cibles du radar
        for (var i = 0; i < 12; i++)
        {
            var angle = Random.NextDouble() * 360.0;
            var radius = 12.0 + Random.NextDouble() * 36.0;

            var radians = angle * Math.PI / 180.0;
            var x = 50.0 + Math.Sin(radians) * radius;
            var y = 50.0 - Math.Cos(radians) * radius;

            Targets.Add(new RadarTarget
            {
                X = x,
                Y = y,
                Delay = -(angle / 360.0 * RadarDuration)
            });
        }

        await LoadGamesAsync();
    }

    private async Task LoadGamesAsync()
    {
        IsLoadingGames = true;
        try
        {
            Games = await Http.GetFromJsonAsync<List<GameStateDto>>("api/games") ?? [];
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors de la récupération des parties : {ex.Message}");
        }
        finally
        {
            IsLoadingGames = false;
        }
    }

    private async Task StartGame()
    {
        IsLoading = true;
        try
        {
            var response = await Http.PostAsync("api/games", null);
            if (response.IsSuccessStatusCode)
            {
                var newGame = await response.Content.ReadFromJsonAsync<GameStateDto>();
                if (newGame != null)
                {
                    Navigation.NavigateTo($"/game?id={newGame.Id}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors de la création de la partie : {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ContinueGame(Guid gameId)
    {
        Navigation.NavigateTo($"/game?id={gameId}");
    }

    private sealed class RadarTarget
    {
        public double X { get; init; }
        public double Y { get; init; }
        public double Delay { get; init; }
    }

    // 1. Mise à jour du DTO
    public sealed class GameStateDto
    {
        public Guid Id { get; set; }
        public Guid PlayerId { get; set; }
        public Guid AiId { get; set; }
        public Guid CurrentPlayerId { get; set; }
        public int Status { get; set; } // Modification string -> int
        public Guid? WinnerId { get; set; }
        public DateTimeOffset CreatedAt { get; set; }
    }

    // 2. Mise à jour de l'affichage du statut
    private static string GetStatusText(GameStateDto game)
    {
        return game.Status switch
        {
            2 => "Terminée",
            1 => "En cours",
            0 => "Placement des bateaux",
            _ => "En cours"
        };
    }
}