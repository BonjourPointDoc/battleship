@page "/game"

@using BattleShip.Models
@using BattleShip.App.Services
@inject GameService GameService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>BattleShip - Partie</PageTitle>

<div class="game">

    <div class="game-header">
        <button class="menu-button" @onclick="ReturnToMenu">
            Retour au menu
        </button>
    </div>

    @if (GameService.IsLoading)
    {
        <div class="loading">Chargement de la partie...</div>
    }
    else if (!string.IsNullOrEmpty(GameService.ErrorMessage))
    {
        <div class="error-message">
            <p>@GameService.ErrorMessage</p>
            <button @onclick="ReturnToMenu">Retour au menu</button>
        </div>
    }
    else
    {
        @if (!GameService.GameStarted)
        {
            <div class="placement-info">
                <h2>Placez vos bateaux</h2>
                <p>Cliquez sur une case pour placer votre bateau.</p>
                <p><strong>Clic droit</strong> pour changer la direction.</p>

                @if (!GameService.PlacementFinished)
                {
                    <div class="current-ship">
                        <span>Bateau : <strong>@GameService.CurrentShipType</strong></span>
                        <span>Taille : <strong>@GameService.CurrentShipType.Size()</strong></span>
                        <span>Direction : <strong>@GameService.CurrentDirection</strong></span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="battle-status">
                @if (GameService.CurrentGame?.Status != 2)
                {
                    <h2>@(GameService.IsPlayerTurn ? "À votre tour de tirer !" : "L'IA réfléchit...")</h2>
                }
            </div>
        }

        <div class="boards">

            <Board Title="Votre flotte"
                   Ships="@GameService.PlacedShipPositions"
                   PreviewShips="@GameService.PreviewShipPositions"
                   PreviewValid="@GameService.IsPreviewValid"
                   Hits="@GameService.PlayerHits"
                   Misses="@GameService.PlayerMisses"
                   Shots="@GameService.PlayerShotsReceived"
                   Sunk="@GameService.PlayerSunk"
                   HideShips="false"
                   OnCellClicked="GameService.OnCellClickedAsync"
                   OnCellRightClicked="GameService.OnCellRightClicked"
                   OnCellMouseEnter="GameService.OnCellMouseEnter"
                   OnCellMouseLeave="GameService.OnCellMouseLeave" />

            <Board Title="Flotte adverse"
                   Hits="@GameService.AiHits"
                   Misses="@GameService.AiMisses"
                   Shots="@GameService.AiShotsReceived"
                   Sunk="@GameService.AiSunk"
                   HideShips="true"
                   OnCellClicked="GameService.OnAiCellClickedAsync" />

        </div>

        @if (GameService.GameStarted && GameService.TurnHistory.Count > 0)
        {
            <div class="history-section" style="margin-top: 1.5rem; max-width: 600px; margin-left: auto; margin-right: auto;">
                <h3>Historique des tirs</h3>
                <div class="history-log" style="max-height: 180px; overflow-y: auto; background: rgba(0,0,0,0.2); padding: 0.75rem; border-radius: 6px;">
                    @foreach (var log in GameService.TurnHistory.AsEnumerable().Reverse())
                    {
                        <p style="margin: 0.25rem 0; font-size: 0.9rem;">@log</p>
                    }
                </div>
            </div>
        }

        @if (GameService.ShowStartingPlayerPopup)
        {
            <div class="popup-overlay">
                <div class="popup">
                    <h2>La partie commence !</h2>
                    <p>@GameService.StartingPlayerMessage</p>
                    <button @onclick="GameService.CloseStartingPlayerPopup">Continuer</button>
                </div>
            </div>
        }
    }

    @if (GameService.CurrentGame?.Status == 2)
    {
        <div class="popup-overlay">
            <div class="popup">
                <h2>Partie terminée !</h2>
                
                <p>
                    @(GameService.CurrentGame.WinnerId == GameService.CurrentGame.PlayerId 
                        ? "Victoire ! Vous avez détruit la flotte adverse !" 
                        : "Défaite ! Votre flotte a été détruite.")
                </p>

                <button @onclick="ReturnToMenu">
                    Retour au menu
                </button>
            </div>
        </div>
    }

</div>

@code {
    [SupplyParameterFromQuery]
    public Guid? Id { get; set; }

    protected override void OnInitialized()
    {
        GameService.OnStateChanged += StateHasChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await GameService.InitializeGameAsync(Id, newId =>
        {
            Navigation.NavigateTo($"/game?id={newId}", replace: true);
        });
    }

    private void ReturnToMenu() => Navigation.NavigateTo("/");

    public void Dispose()
    {
        GameService.OnStateChanged -= StateHasChanged;
    }
}